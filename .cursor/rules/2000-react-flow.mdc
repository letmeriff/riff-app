### Common Pitfalls to Avoid
- **Not using ReactFlowProvider**: Always wrap your component with ReactFlowProvider when using React Flow hooks outside the ReactFlow component
- **Manual state updates**: Avoid manually updating node/edge state; use the provided hooks and utilities instead
- **Missing Handle components**: Always include Handle components in custom nodes for proper connections
- **Incorrect CSS**: Set `overflow: visible` on node containers to ensure handles are clickable
- **Unstable callbacks**: Always wrap event handlers with useCallback to prevent unnecessary re-renders
- **Direct DOM manipulation**: Never directly manipulate the DOM to create or position nodes
- **Missing key props**: Always provide unique keys when rendering lists of nodes or edges
- **Incorrect type definitions**: Ensure your type definitions match the actual React Flow API
- **Nested ReactFlow instances**: Avoid nesting ReactFlow components without proper isolation
- **Using old property names**: Use `parentId` instead of `parentNode`, `onReconnect` instead of `onEdgeUpdate`
- **Not understanding dimensions**: Understand the difference between explicitly set dimensions (`width`/`height`) and measured dimensions (`measured.width`/`measured.height`)
- **Incorrect imports**: Use named imports from `@xyflow/react` instead of default imports from `reactflow`

<example type="invalid">
```tsx
// Poor implementation with common pitfalls
import ReactFlow from '@xyflow/react'; // Incorrect: should use named import

function BadFlow() {
  // Missing useNodesState and useEdgesState
  const [nodes, setNodes] = useState([]);
  const [edges, setEdges] = useState([]);
  
  // Missing useCallback
  function onConnect(params) {
    // Direct state mutation without addEdge utility
    setEdges([...edges, { 
      id: `e${edges.length}`, 
      source: params.source, 
      target: params.target 
    }]);
  }
  
  // Missing useCallback
  function handleAddNode() {
    // Direct state mutation
    setNodes([...nodes, {
      id: `node-${nodes.length}`,
      position: { x: 100, y: 100 },
      data: { label: 'New Node' }
    }]);
  }
  
  // Using old property name
  function addChildNode() {
    setNodes([...nodes, {
      id: 'child-1',
      parentNode: 'parent-1', // Incorrect: should be parentId
      position: { x: 10, y: 10 },
      data: { label: 'Child Node' }
    }]);
  }
  
  return (
    <div>
      <button onClick={handleAddNode}>Add Node</button>
      <ReactFlow
        nodes={nodes}
        edges={edges}
        // Missing onNodesChange and onEdgesChange
        onConnect={onConnect}
        // Using old event name
        onEdgeUpdate={(oldEdge, newConnection) => {
          // Should be onReconnect
        }}
      />
    </div>
  );
}
```
</example>

### Performance Optimization
- Use memoization for expensive calculations and component rendering
- Implement virtualization for large graphs
- Use `useCallback` for event handlers to prevent unnecessary re-renders
- Optimize custom node and edge components
- Use `useNodesState` and `useEdgesState` hooks for efficient state management
- Consider using uncontrolled flow for very large graphs
- Use the `nodeExtent` prop to limit the draggable area for better performance

<example>
```tsx
// Optimized component with memoization
const MemoizedCustomNode = React.memo(({ data }) => {
  // Node implementation
});

// Optimized event handlers
const onConnect = useCallback(
  (params) => setEdges((eds) => addEdge(params, eds)),
  [setEdges]
);

// Using nodeExtent to limit draggable area
<ReactFlow
  nodes={nodes}
  edges={edges}
  nodeExtent={[
    [0, 0],
    [1000, 1000]
  ]}
/>
```
</example>

## Examples

<example>
```tsx
// Basic React Flow setup with v12 features
import { useCallback } from 'react';
import {
  ReactFlow,
  MiniMap,
  Controls,
  Background,
  useNodesState,
  useEdgesState,
  addEdge,
  Panel,
} from '@xyflow/react';
import '@xyflow/react/dist/style.css';

const initialNodes = [
  { id: '1', position: { x: 0, y: 0 }, data: { label: 'Node 1' } },
  { id: '2', position: { x: 0, y: 100 }, data: { label: 'Node 2' } },
];

const initialEdges = [{ id: 'e1-2', source: '1', target: '2' }];

function Flow() {
  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes);
  const [edges, setEdges, onEdgesChange] = useEdgesState(initialEdges);

  const onConnect = useCallback(
    (params) => setEdges((eds) => addEdge(params, eds)),
    [setEdges]
  );

  return (
    <div style={{ width: '100%', height: '500px' }}>
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        onConnect={onConnect}
        fitView
        colorMode="light" // New in v12: supports "light", "dark", or "system"
      >
        <Controls />
        <MiniMap />
        <Background variant="dots" gap={12} size={1} />
        <Panel position="top-right">
          <button>Action</button>
        </Panel>
      </ReactFlow>
    </div>
  );
}

export default function App() {
  return (
    <ReactFlowProvider>
      <Flow />
    </ReactFlowProvider>
  );
}
```
</example>

