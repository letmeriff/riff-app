## Testing

When testing components that use the messaging architecture:

1. Mock the network adapter and event handlers
2. Test type guards with both valid and invalid payloads
3. Verify payload validation rejects invalid data
4. Use the multi-user test harness for testing collaboration features

```typescript
// Example test for network event handling
test('handles message updates correctly', async () => {
  // Mock event subscription
  mockSubscribeToEvent.mockImplementation((eventName, callback) => {
    if (eventName === 'message-update') {
      eventHandlers.add(callback);
    }
    return () => eventHandlers.delete(callback);
  });
  
  // Render component
  render(<MyComponent />);
  
  // Create a valid payload
  const validPayload: MessageUpdatePayload = {
    nodeId: 123,
    new: {
      node_id: 123,
      message_id: 456,
      content: 'Test message',
      is_user: true,
      timestamp: new Date().toISOString()
    }
  };
  
  // Trigger the event
  eventHandlers.forEach(handler => handler(validPayload));
  
  // Verify the component updated correctly
  expect(screen.getByText('Test message')).toBeInTheDocument();
});
``` 