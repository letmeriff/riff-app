# Supabase Configuration
# Required for both local development and deployment
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Vercel Configuration
# Required ONLY for CI/CD deployment processes
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# Render Configuration
# Required ONLY for CI/CD deployment processes
RENDER_API_KEY=your_render_api_key
RENDER_SERVICE_ID=your_render_staging_service_id
RENDER_PROD_SERVICE_ID=your_render_prod_service_id

# Environment
# Required for both local development and deployment
NODE_ENV=development

# Canvas Feature Flags
# Controls various canvas-related features
REACT_APP_CANVAS_REFACTORED=true
REACT_APP_CANVAS_PERFORMANCE=true
REACT_APP_CANVAS_VIRTUALIZATION=false 